# Keep heavy scanning disabled on the Render free tier.
ENABLE_LIVE_SCAN=0

# GitHub workflow dispatched by POST /api/scan/trigger.
GH_REPO=eliorbudkov/stockanalyst.github.io
GH_WORKFLOW=refresh-seed.yml
GH_REF=main

# Server-only token. Never expose this as NEXT_PUBLIC_*.
# Fine-grained permissions: repository access plus Actions read/write.
GH_DISPATCH_TOKEN=github_pat_REPLACE_ME

# Optional external API used by analysis modules.
ANTHROPIC_API_KEY=
