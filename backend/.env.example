# Local FastAPI development
ENABLE_LIVE_SCAN=1
ALLOWED_ORIGINS=http://localhost:3000
# Optional override. The default already allows this project's Vercel URLs.
# ALLOWED_ORIGIN_REGEX=https://stockanalyst-github-io-emy4(?:-[a-z0-9-]+)?\.vercel\.app

# Optional shared password for local testing. Leave unset to disable local auth.
# APP_PASSWORD=choose-a-long-random-passphrase

# Production / GitHub scan dispatch. Keep ENABLE_LIVE_SCAN=0 on Render Free.
# GH_REPO=eliorbudkov/stockanalyst.github.io
# GH_WORKFLOW=refresh-seed.yml
# GH_REF=main
# GH_DISPATCH_TOKEN=github_pat_REPLACE_ME

# Optional providers.
# ANTHROPIC_API_KEY=sk-ant-...
