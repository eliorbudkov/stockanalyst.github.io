# ── Frontend (.env.local, read by Next.js) ─────────────────────────────────────

# Production Render backend. Local frontend should use the same API as Vercel.
NEXT_PUBLIC_API_URL=https://stockanalyst-github-io.onrender.com

# Auto-logout after this many idle minutes (min 5, default 30).
NEXT_PUBLIC_AUTH_IDLE_MINUTES=30

# Local development only: bypasses the /login gate when the backend has no auth.
# Never set this in Vercel.
NEXT_PUBLIC_AUTH_ALLOW_UNCONFIGURED_LOCAL=1

# IMPORTANT: there is NO password variable here. The single shared site password
# is set ONLY on the server (APP_PASSWORD, see below) and typed by the user at
# /login. Never put the password in this file or in any NEXT_PUBLIC_ variable —
# anything NEXT_PUBLIC_ is shipped to the browser in plain text.

# ── Backend (backend/.env locally, Render dashboard in production) ──────────────

# The single shared site password. Set it here for local backend runs, and in
# the Render dashboard for production. Its presence turns the auth gate on.
# APP_PASSWORD=choose-a-long-random-passphrase

# Anthropic for sentiment / report analysis (server-only).
# ANTHROPIC_API_KEY=sk-ant-...
